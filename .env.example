# Copia este archivo a .env y ajusta los valores si lo necesitas.
# HERMES lee estas variables del entorno (no se guardan secretos en el código).
# Ejemplo en Windows (PowerShell):  $env:HERMES_PINGS = "8"
# Ejemplo en Linux/macOS:           export HERMES_PINGS=8

# Host al que se hace ping para medir Internet
HERMES_HOST_PRUEBA=8.8.8.8
# Cantidad de pings por medición (2 a 20). Más pings = medición más fiable pero más lenta.
HERMES_PINGS=5

# Credenciales del router (OPCIONAL). Lo más seguro es dejar que HERMES las pida
# al momento (la contraseña no se muestra). Si las defines aquí, NUNCA subas el
# archivo .env a GitHub (ya está en .gitignore).
# HERMES_ROUTER_USER=admin
# HERMES_ROUTER_PASS=
